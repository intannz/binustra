+  }
+
+  if (nilai === undefined || nilai.nilaiAkhir === null) {
+    return <p className={styles.scoreDetail}>Belum dinilai oleh guru pembimbing</p>;
+  }
+
+  return (
+    <>
+      <p className={styles.scoreValue}>{formatNilai(nilai.nilaiAkhir)}</p>
+      <p className={styles.scoreDetail}>
+        Sikap {formatNilai(nilai.sikap)} · Keterampilan {formatNilai(nilai.keterampilan)} · Kedisiplinan {formatNilai(nilai.kedisiplinan)}
+      </p>
+    </>
+  );
+}
