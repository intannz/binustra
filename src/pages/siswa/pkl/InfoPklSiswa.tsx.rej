-  FiX, FiUploadCloud
+import { useState, type ChangeEvent, type FormEvent } from 'react';
+import {
+  FiBell, FiChevronRight, FiBriefcase, FiUpload, FiFileText,
+  FiX, FiUploadCloud, FiAlertCircle, FiRefreshCw
 } from 'react-icons/fi';
 import Sidebar from '../../../components/layout/Sidebar';
 import Footer from '../../../components/layout/Footer';
 import styles from './InfoPklSiswa.module.css';
 
+import { useApi } from '../../../hooks/useApi';
+import { useAuth } from '../../../hooks/useAuth';
+import { getFieldErrors, isApiError } from '../../../services/api';
+import { getNilaiPklSiswa, getPklSiswa, uploadLaporanPkl } from '../../../services/pkl.service';
+import type {
+  KontakPembimbing,
+  NilaiPklSiswa,
+  PklSiswa,
+  StatusPkl,
+} from '../../../types/portal.types';
+import { formatNilai, formatTanggal, getInisial } from '../../../utils/formatter';
+
+/* ========================================================================== */
+/* Konstanta & helper                                                         */
+/* ========================================================================== */
+
+/** Batas ukuran laporan PKL yang diterima server (S-PKL-3) */
+const MAX_REPORT_SIZE = 10 * 1024 * 1024;
+
+const STATUS_PKL_LABEL: Record<StatusPkl, string> = {
+  'Belum Dimulai': 'Belum dimulai',
+  Aktif: 'Sedang berlangsung',
+  Selesai: 'Selesai',
+};
+
+function formatPembimbing({ nama, kontak }: KontakPembimbing): string {
+  return kontak ? `${nama} (${kontak})` : nama;
+}
+
+function getProgress(pkl: PklSiswa): { label: string; percent: number } {
+  const { bulanKe, totalBulan } = pkl.progres;
+  if (pkl.status === 'Belum Dimulai') return { label: 'PKL belum dimulai', percent: 0 };
+
+  const percent = totalBulan > 0 ? Math.min(100, Math.round((bulanKe / totalBulan) * 100)) : 0;
+  return { label: `Bulan ${bulanKe} dari ${totalBulan}`, percent };
+}
+
+/** Tampilan kartu laporan sesuai status laporan: belum ada, menunggu, revisi, atau disetujui */
+interface LaporanView {
+  label: string;
+  badgeClass: string;
+  description: string;
+  /** Catatan revisi dari guru, hanya terisi saat status revisi */
+  catatan: string | null;
+  canUpload: boolean;
+  uploadLabel: string;
+}
+
+function getLaporanView(pkl: PklSiswa | undefined, loading: boolean): LaporanView {
+  const uploadLabel = 'Unggah laporan akhir PKL';
+
+  if (pkl === undefined) {
+    return {
+      label: loading ? 'Memuat…' : 'Belum tersedia',
+      badgeClass: styles.badgeWarning,
+      description: 'Laporan dapat diunggah setelah data penempatan PKL berhasil dimuat',
+      catatan: null,
+      canUpload: false,
+      uploadLabel,
+    };
+  }
+
+  const laporan = pkl.laporan;
+  if (laporan === null) {
+    return {
+      label: 'Belum diunggah',
+      badgeClass: styles.badgeWarning,
+      description: 'Lengkapi laporan sebagai penilaian PKL',
+      catatan: null,
+      canUpload: true,
+      uploadLabel,
+    };
+  }
+
+  if (laporan.status === 'revisi') {
+    return {
+      label: 'Perlu revisi',
+      badgeClass: styles.badgeDanger,
+      description: 'Guru pembimbing meminta perbaikan. Unggah ulang laporan yang sudah direvisi',
+      catatan: laporan.catatan,
+      canUpload: true,
+      uploadLabel: 'Unggah ulang laporan revisi',
+    };
+  }
+
+  if (laporan.status === 'menunggu') {
+    return {
+      label: 'Menunggu verifikasi',
+      badgeClass: styles.badgeWarning,
+      description: 'Laporan sedang diperiksa guru pembimbing',
+      catatan: null,
+      canUpload: false,
+      uploadLabel,
+    };
+  }
+
+  return {
+    label: 'Disetujui',
+    badgeClass: styles.badgeSuccess,
+    description: 'Laporan telah disetujui guru pembimbing',
+    catatan: laporan.catatan,
+    canUpload: false,
+    uploadLabel,
+  };
+}
+
+/** Kembalikan pesan masalah bila berkas tidak memenuhi syarat, null bila valid */
+function validateReportFile(file: File): string | null {
+  if (file.type !== 'application/pdf') return 'Berkas harus berformat PDF.';
+  if (file.size > MAX_REPORT_SIZE) return 'Ukuran berkas maksimal 10 MB.';
+  return null;
+}
+
+interface UploadFailure {
+  message: string;
+  /** true bila kegagalan berarti data di layar sudah tidak sesuai dengan server */
+  staleState: boolean;
+}
+
+function toUploadFailure(err: unknown): UploadFailure {
+  if (!isApiError(err)) {
+    return { message: 'Terjadi kesalahan saat mengunggah laporan. Silakan coba lagi.', staleState: false };
+  }
+
+  switch (err.code) {
+    case 'PKL_NOT_FOUND':
+      return {
+        message: 'Anda belum memiliki penempatan PKL, sehingga laporan belum dapat diunggah.',
+        staleState: true,
+      };
+    case 'LAPORAN_TIDAK_DAPAT_DIUBAH':
+      return {
+        message: 'Laporan sudah dikirim dan hanya dapat diganti saat guru pembimbing meminta revisi.',
+        staleState: true,
+      };
+    case 'FILE_TYPE_INVALID':
+      return { message: 'Berkas harus berupa dokumen PDF yang valid.', staleState: false };
+    case 'FILE_TOO_LARGE':
+      return { message: 'Ukuran berkas melebihi batas 10 MB.', staleState: false };
+    case 'VALIDATION_ERROR':
+      return { message: getFieldErrors(err).file ?? err.message, staleState: false };
+    default:
+      return { message: err.message, staleState: false };
+  }
+}
+
+/* ========================================================================== */
+/* Bagian tampilan                                                            */
+/* ========================================================================== */
+
+function Timeline({ pkl }: { pkl: PklSiswa }) {
+  const started = pkl.status !== 'Belum Dimulai';
+  const finished = pkl.status === 'Selesai';
+
+  let middle: { date: string; title: string; desc: string };
+  if (pkl.status === 'Belum Dimulai') {
+    middle = {
+      date: 'Belum dimulai',
+      title: 'PKL belum berlangsung',
+      desc: `Dimulai ${formatTanggal(pkl.periode.mulai)}`,
+    };
+  } else if (pkl.status === 'Aktif') {
+    middle = {
+      date: 'Saat ini',
+      title: 'PKL sedang berlangsung',
+      desc: `Bulan ke-${pkl.progres.bulanKe} dari ${pkl.progres.totalBulan}`,
+    };
+  } else {
+    middle = {
+      date: 'Selesai',
+      title: 'Pelaksanaan PKL selesai',
+      desc: `Total ${pkl.progres.totalBulan} bulan`,
+    };
+  }
+
+  return (
+    <div className={styles.card}>
+      <h3>Linimasa PKL</h3>
+      <div className={styles.timeline}>
+        <div className={styles.timelineItem}>
+          <div className={started ? styles.timelineDotActive : styles.timelineDot}></div>
+          <div className={started ? styles.timelineLineActive : styles.timelineLine}></div>
+          <p className={styles.timelineDate}>{formatTanggal(pkl.periode.mulai)}</p>
+          <h4>Mulai praktik kerja lapangan</h4>
+          <p className={styles.timelineDesc}>Penempatan di {pkl.industri.nama}</p>
+        </div>
+        <div className={styles.timelineItem}>
+          <div className={started ? styles.timelineDotActive : styles.timelineDot}></div>
+          <div className={finished ? styles.timelineLineActive : styles.timelineLine}></div>
+          <p className={styles.timelineDate}>{middle.date}</p>
+          <h4>{middle.title}</h4>
+          <p className={styles.timelineDesc}>{middle.desc}</p>
+        </div>
+        <div className={styles.timelineItem}>
+          <div className={finished ? styles.timelineDotActive : styles.timelineDot}></div>
+          <p className={styles.timelineDate}>{formatTanggal(pkl.periode.selesai)}</p>
+          <h4>Akhir periode PKL</h4>
+          <p className={styles.timelineDesc}>Pengumpulan laporan dan penilaian akhir</p>
+        </div>
+      </div>
+    </div>
+  );
+}
+
+interface NilaiSummaryProps {
+  nilai: NilaiPklSiswa | undefined;
+  loading: boolean;
+  errorMessage: string | null;
+  onRetry: () => void;
+}
+
+function NilaiSummary({ nilai, loading, errorMessage, onRetry }: NilaiSummaryProps) {
+  if (nilai === undefined && loading) {
+    return <p className={styles.scoreDetail} role="status">Memuat nilai…</p>;
+  }
+
+  if (errorMessage !== null) {
+    return (
+      <p className={styles.scoreError} role="alert">
+        {errorMessage}{' '}
+        <button type="button" className={styles.inlineRetry} onClick={onRetry}>Coba lagi</button>
+      </p>
+    );
+  }
+
+  if (nilai === undefined || nilai.nilaiAkhir === null) {
+    return <p className={styles.scoreDetail}>Belum dinilai oleh guru pembimbing</p>;
+  }
+
+  return (
+    <>
+      <p className={styles.scoreValue}>{formatNilai(nilai.nilaiAkhir)}</p>
+      <p className={styles.scoreDetail}>
+        Sikap {formatNilai(nilai.sikap)} · Keterampilan {formatNilai(nilai.keterampilan)} · Kedisiplinan {formatNilai(nilai.kedisiplinan)}
+      </p>
+    </>
+  );
+}
+
+/* ========================================================================== */
+/* Halaman                                                                    */
+/* ========================================================================== */
+
